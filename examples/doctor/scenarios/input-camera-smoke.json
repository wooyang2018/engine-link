{
  "schema": "enginelink.doctor-scenario.v1",
  "name": "input-camera-smoke",
  "map": "/Game/Maps/YourMap",
  "clients": 1,
  "timeoutSeconds": 120,
  "steps": [
    { "action": "start_pie" },
    { "action": "wait_for_pie", "timeout_seconds": 20 },
    { "action": "wait_for_local_players", "count": 1, "timeoutMs": 20000 },
    { "action": "input_action_bound", "context": "/Game/Input/IMC_Default.IMC_Default", "path": "/Game/Input/IA_Move.IA_Move", "key": "W" },
    { "action": "snapshot_player", "name": "move_before" },
    { "action": "inject_action", "path": "/Game/Input/IA_Move.IA_Move", "value": { "type": "Axis2D", "x": 0, "y": 1 }, "repeat": 20, "intervalMs": 16 },
    { "action": "snapshot_player", "name": "move_after" },
    { "action": "actor_location_changed", "from": "move_before", "to": "move_after", "minDistance": 10 },
    { "action": "snapshot_player", "name": "look_before" },
    { "action": "inject_action", "path": "/Game/Input/IA_Look.IA_Look", "value": { "type": "Axis2D", "x": 1, "y": 1 }, "durationMs": 250, "interval_ms": 16 },
    { "action": "snapshot_player", "name": "look_after" },
    { "action": "control_rotation_changed", "from": "look_before", "to": "look_after", "axis": "yaw", "minDegrees": 1 },
    { "action": "player_camera_pitch_limits", "min": -60, "max": 60 },
    { "action": "capture_game", "name": "input-camera-smoke" }
  ],
  "teardown": { "stop_pie": true }
}
